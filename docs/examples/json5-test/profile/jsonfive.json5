// The profile, written as .json5. Its .json twin is identical except for the
// description, so which one is in play is visible in /lcdev report and nowhere
// else. Both are correct: neither changes what generates.
{
  "lostcity": {
    "worldStyle": "j5:demo",
    "description": "written as .json5",

    "ruinChance": 0.0,          // keep every tower intact and countable
    "generateLoot": false,
    "buildingMinFloors": 3,
    "buildingMaxFloors": 3,
    "buildingMinCellars": 0,
    "buildingMaxCellars": 0,
  },
  "cities": {
    /* Only the pinned chunks are city chunks. */
    "cityChance": 0.0,
  },
  "explosions": {
    "explosionChance": 0.0,
    "miniExplosionChance": 0.0,
  },
}
